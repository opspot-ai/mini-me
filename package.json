{
  "name": "mini-me-portable",
  "version": "0.1.0",
  "private": true,
  "description": "A local personal adviser with portable MCP, CLI, and library interfaces.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=26.7.0 <27"
  },
  "files": [
    "dist/**",
    "README.md",
    "LICENSE",
    "NOTICE.md",
    "plugin.json",
    "mcp.json",
    "skills/**"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "mini-me": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.mjs",
    "verify": "npm run build && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "typebox": "1.3.34",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "typescript": "5.9.3"
  }
}
